{
  "expo": {
    "name": "Rentalova",
    "slug": "rentalova",
    "scheme": "rentalova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4b9c78"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentalova.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Rentalova necesita acceso a tu cámara para fotografiar tus productos.",
        "NSPhotoLibraryUsageDescription": "Rentalova necesita acceso a tu galería para subir fotos de tus productos.",
        "NSPhotoLibraryAddUsageDescription": "Rentalova necesita acceso a tu galería para subir fotos de tus productos.",
        "NSLocationWhenInUseUsageDescription": "Rentalova usa tu ubicación para mostrarte productos cercanos.",
        "NSUserNotificationUsageDescription": "Rentalova te envía notificaciones sobre tus alquileres y mensajes."
      }
    },
    "android": {
      "package": "com.rentalova.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#4b9c78"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.255488630206-ajd9f88711fkachg2bcehdle577m7lom"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4b9c78",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rentalova usa tu ubicación para mostrarte productos cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rentalova necesita acceso a tu galería para subir fotos de tus productos.",
          "cameraPermission": "Rentalova necesita acceso a tu cámara para fotografiar tus productos."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.rentalova.app"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1513533f-d7e4-4daa-8414-7136c256a0a2"
      }
    }
  }
}
